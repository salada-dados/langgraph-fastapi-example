# --- LLM: pick ONE option, set the model and its API key -------------------
# Format: LLM_MODEL=provider:model-name

# Option A: Anthropic (key: https://console.anthropic.com/settings/keys)
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=your-key

# Option B: OpenAI (key: https://platform.openai.com/api-keys)
# LLM_MODEL=openai:gpt-5
# OPENAI_API_KEY=your-key

# --- Optional ---------------------------------------------------------------
# LLM_TEMPERATURE=0     # leave unset for models that only accept the default
REQUEST_TIMEOUT=10      # seconds, for tool HTTP calls
MAX_MESSAGE_LENGTH=4000 # max characters per user message
AGENT_RECURSION_LIMIT=10 # max graph steps per request (agent → tools = 2 steps)
